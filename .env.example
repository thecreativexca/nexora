# ---------------------------------------------------------------------------
# Nexora POS & Storefront - environment variables
#
# Phase 1: Online PayPal payments have been removed. The system now uses
# fully offline payment collection (Cash, UPI, Card, Bank Transfer, Cheque).
#
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env`, `.env.local` or real credentials.
# ---------------------------------------------------------------------------
#
# Copy this file to `.env.local` and fill in your own values.
# NEVER commit `.env`, `.env.local` or real credentials.
# ---------------------------------------------------------------------------

# MongoDB connection string (server-only, never exposed to the browser).
#
# Local single-node replica set (transactions supported):
#   mongod --replSet nexora-rs --port 27018 --dbpath <data-dir>
#   mongosh "mongodb://127.0.0.1:27018/admin" --eval "rs.initiate()"
#   MONGODB_URI="mongodb://127.0.0.1:27018/nexora_dev?replicaSet=nexora-rs&directConnection=true"
#
# MongoDB Atlas (recommended for production):
#   MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nexora?retryWrites=true&w=majority"
#
# NOTE: order creation uses a MongoDB transaction, so a replica-set capable
# deployment is required. Standalone mongod servers are rejected with a clear
# SERVICE_UNAVAILABLE error instead of silently losing atomicity.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nexora?retryWrites=true&w=majority

# Absolute base URL of this app. Used for canonical metadata URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Orders & reports (Phase 5)
# ---------------------------------------------------------------------------

# IANA timezone used for "business day" boundaries: the orders-list day filter,
# reports' "orders today" window and the 7-day revenue chart all group by this
# zone, never the browser or server-local clock. Change it if the store operates
# in another zone; the reports UI displays the active value.
BUSINESS_TIMEZONE=Asia/Kolkata

# Customer sessions, OAuth state/PKCE and password-reset OTP HMACs.
# Generate a random value of at least 32 bytes. Keep separate from staff auth.
AUTH_SECRET=

# ---------------------------------------------------------------------------
# LEGACY: PayPal REST Orders v2 (Phase 1 - DECOMMISSIONED)
# ---------------------------------------------------------------------------
# These variables are no longer used for new orders. They are kept here for
# reference only. The PayPal API routes now return 410 Gone. The webhook
# handler returns 200 without processing. Historical order records that
# contain paypalOrderId/paypalCaptureId remain accessible read-only.
#
# PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_ENVIRONMENT=sandbox
# PAYPAL_CURRENCY=INR
# PAYPAL_WEBHOOK_ID=

# Google OAuth web client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend transactional email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nexora <no-reply@example.com>

# Cloudinary product image uploads (server-only credentials).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
